# Copy to .env (make setup does this). Never commit .env.
# MLflow backend; default matches vehicle_detect.train
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Dataset hubs (only needed by `make download` for the matching source)
HF_TOKEN=
ROBOFLOW_API_KEY=
# Kaggle uses ~/.kaggle/kaggle.json instead
# DVC remote for `make dvc-init` (local disk or NAS, D-015)
DVC_REMOTE=
